# ============================================================
# Конфигурация «AI замість фінансиста» — бот + дашборд + адмінка
# ============================================================
# Скопируйте этот файл в КОРЕНЬ репозитория как .env:
#   cp bot/.env.example .env
#
# Для Docker: .env должен быть в корне (рядом с docker-compose.yml).
# Он монтируется в контейнер автоматически.

# --- Сервер дашборда/админки ---
# Пароль для входа в админку (http://localhost:8000/admin)
ADMIN_PASSWORD=change-me-admin
# Мастер-ключ для шифрования секретов в БД (любая строка; НЕ меняй после первого запуска,
# иначе зашифрованные ключи станут нечитаемыми)
SECRET_KEY=change-me-secret-12345

# --- Telegram Bot Token ---
# Получить у @BotFather в Telegram (команда /newbot).
# Можно задать тут ИЛИ через админку (/admin → Ключі API).
TELEGRAM_BOT_TOKEN=123456789:AAExxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- DeepSeek API Key ---
# Получить на https://platform.deepseek.com/ → API Keys.
# Можно задать тут ИЛИ через админку.
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Google Service Account (для экспорта в Sheets, опция) ---
# Путь к JSON-ключу. Если задашь через админку — это поле игнорируется.
GOOGLE_CREDENTIALS_JSON=./service-account.json

# --- ID Google-таблицы (опция; также настраивается в админке) ---
# GOOGLE_SHEET_ID=1mQor8lIqxTto-IIHuX4tMWoOHzeeg-KTBiJWMA10jwQ
